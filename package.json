{
  "name": "surfra",
  "version": "0.3.0",
  "description": "Surfra SDK: volumes, apps and jobs on serverless GPUs across your own clouds",
  "license": "Apache-2.0",
  "homepage": "https://docs.surfra.io",
  "repository": { "type": "git", "url": "git+https://github.com/surfra-io/surfra-typescript.git" },
  "keywords": ["gpu", "serverless", "inference", "storage", "ml", "surfra"],
  "type": "module",
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "exports": {
    ".": {
      "node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
      "default": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
